{
  "kind": "collectionType",
  "collectionName": "library_users",
  "info": {
    "singularName": "library-user",
    "pluralName": "library-users",
    "displayName": "Library_User",
    "description": ""
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string"
    },
    "email": {
      "type": "email"
    },
    "profilepic": {
      "type": "media",
      "multiple": true,
      "required": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "user_id": {
      "type": "uid"
    },
    "books": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::book.book"
    },
    "password": {
      "type": "string"
    }
  }
}
